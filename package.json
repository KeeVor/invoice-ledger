{
  "name": "invoice-ledger",
  "productName": "票迹",
  "version": "0.4.1",
  "private": true,
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "description": "Local-first invoice recognition and duplicate prevention for Windows",
  "author": "Invoice Ledger",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "icons": "node scripts/build-icons.mjs",
    "start": "electron .",
    "test": "node scripts/test.mjs",
    "test:python": ".venv\\Scripts\\python.exe -m unittest discover -s tests -p test_*.py",
    "test:smoke": "node scripts/smoke.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:package": "node scripts/check-package.mjs",
    "clean": "node scripts/clean-artifacts.mjs --test --build",
    "clean:test": "node scripts/clean-artifacts.mjs --test",
    "clean:build": "node scripts/clean-artifacts.mjs --build",
    "python:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-python.ps1",
    "python:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-python.ps1",
    "dist": "node scripts/clean-artifacts.mjs --release-before && npm run build && npm run python:build && node scripts/licenses.mjs && electron-builder --win nsis --publish never && node scripts/clean-artifacts.mjs --release-after",
    "dist:dir": "node scripts/clean-artifacts.mjs --release-before && npm run build && npm run python:build && node scripts/licenses.mjs && electron-builder --win --dir --publish never && node scripts/clean-artifacts.mjs --release-dir-after",
    "postinstall": "node -e \"require('better-sqlite3')(':memory:').close()\"",
    "test:updates:ui": "node scripts/update-ui-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource/manrope": "^5.2.8",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "6.8.9",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.7.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "js-yaml": "5.4.3",
    "playwright-core": "^1.64.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "local.piaoji.ledger",
    "productName": "票迹",
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "toolsets": {
      "winCodeSign": "1.0.0"
    },
    "directories": {
      "output": "release/current",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "extraResources": [
      {
        "from": "python-dist/invoice-worker",
        "to": "ocr"
      },
      {
        "from": "python/licenses",
        "to": "licenses",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Piaoji-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KeeVor",
        "repo": "invoice-ledger",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KeeVor/invoice-ledger.git"
  },
  "homepage": "https://github.com/KeeVor/invoice-ledger",
  "bugs": {
    "url": "https://github.com/KeeVor/invoice-ledger/issues"
  }
}
